.admin-seed button:hover { background: #30363d; }

/* ===== ADMIN DARK THEME VARIABLES ===== */
:root .admin-body {
  --admin-bg: #0d1117;
  --admin-card: #161b22;
  --admin-card-hover: #1c2128;
  --admin-border: #30363d;
  --admin-text: #c9d1d9;
  --admin-muted: #8b949e;
  --admin-accent: #58a6ff;
  --admin-success: #3fb950;
  --admin-danger: #f85149;
}
